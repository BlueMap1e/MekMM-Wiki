---
// 自定义页脚:在 astro.config.mjs 的 components.Footer 里挂载,替换官方默认页脚(装修梯度④)。
// 页脚属于站点外观,文案随便改;这里保持克制,只放站点归属信息。
//
// 颜色不用 Starlight 的灰阶变量(它们在深浅主题下方向相反,语义容易踩坑),
// 而是自定义一套页脚专用变量,明暗两套值都写死,保证对比度可控。
const year = new Date().getFullYear();
---

<footer class="mekmm-footer">
	<div class="mekmm-footer__inner">
		<p>
			© {year} MekMM Wiki · 模组 <a href="https://github.com/lostmyself8/Mekanism-MoreMachine">Mekanism: More Machine</a> by lostmyself8 · 内容以 <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.zh">CC BY-SA 4.0</a> 授权
		</p>
		<p class="mekmm-footer__powered">
			<a href="https://starlight.astro.build">Powered by Starlight</a>
		</p>
	</div>
</footer>

<style>
	/* Astro 会给组件样式加作用域,:root 级别的变量必须用 :global() 才能挂到 <html> 上 */
	:global(:root) {
		--mekmm-footer-text: #eeeeee;
		--mekmm-footer-muted: #b4b4b4;
	}
	:global(:root[data-theme='light']) {
		--mekmm-footer-text: #202020;
		--mekmm-footer-muted: #646464;
	}
	.mekmm-footer {
		border-top: 1px solid color-mix(in srgb, var(--mekmm-footer-muted) 35%, transparent);
		margin-top: 3rem;
		padding: 1.25rem 0 2rem;
	}
	.mekmm-footer__inner {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		justify-content: space-between;
		margin: 0 auto;
		padding: 0 1rem;
	}
	.mekmm-footer p {
		margin: 0;
		color: var(--mekmm-footer-muted);
		font-size: 0.85rem;
	}
	.mekmm-footer a {
		color: var(--mekmm-footer-text);
		text-decoration-color: var(--sl-color-accent);
		text-underline-offset: 3px;
	}
	.mekmm-footer a:hover {
		color: var(--sl-color-accent-high);
	}
	@media (max-width: 50rem) {
		.mekmm-footer__inner {
			flex-direction: column;
		}
	}
</style>
